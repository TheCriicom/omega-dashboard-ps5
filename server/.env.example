# Modello di .env. Il modo più semplice per crearlo è scripts/install.sh, che
# genera i segreti. Dopo il primo avvio non cambiare PGPASSWORD (perderesti
# l'accesso al database) né OMEGA_SESSION_SECRET (disconnetteresti tutti).

PGUSER=omega
PGDATABASE=omega
PGPASSWORD=

# almeno 32 caratteri casuali: openssl rand -hex 32
OMEGA_SESSION_SECRET=
OMEGA_SESSION_TTL_SECONDS=86400
# chiave da inserire alla registrazione; vuota = registrazione aperta
OMEGA_REGISTRATION_KEY=

# dominio per l'HTTPS automatico (compose.tls.yml) e indirizzo pubblico
OMEGA_DOMAIN=
PUBLIC_BASE_URL=http://localhost:8090
# porta locale del server; OMEGA_BIND=0.0.0.0 per esporla senza reverse proxy
OMEGA_PORT=8090
OMEGA_BIND=127.0.0.1

# titolare del servizio, mostrato in privacy e termini ("[da completare]" se vuoti)
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_VAT=
LEGAL_CONTROLLER_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_HOSTING_PROVIDER=

# giorni di conservazione dei registri delle richieste
LOG_RETENTION_DAYS=30
# segnalatori distinti oltre cui un contenuto si oscura in attesa di verifica
STORE_AUTOHIDE_REPORTS=3
