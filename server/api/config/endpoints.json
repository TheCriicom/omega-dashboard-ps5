{
  "_doc": "Rotte dell'api. handler = <modulo>.<funzione> in src/endpoints/; auth: true = token di sessione (POST /api/v1/auth/login), \"admin\" = cookie del pannello. Le rotte /api/v1/... rispondono anche come /lab/v1/... (app console meno recenti).",
  "endpoints": [
    { "method": "GET",    "path": "/",                                            "handler": "site.home",                "family": "site",    "auth": false, "note": "sito pubblico" },
    { "method": "GET",    "path": "/installa",                                    "handler": "site.install",             "family": "site",    "auth": false, "note": "installazione dalla console" },
    { "method": "GET",    "path": "/assets/:file",                                "handler": "site.asset",               "family": "site",    "auth": false },
    { "method": "GET",    "path": "/assets/:dir/:file",                           "handler": "site.asset",               "family": "site",    "auth": false },
    { "method": "GET",    "path": "/api/v1",                                      "handler": "info.index",               "family": "info",    "auth": false, "note": "descrizione dell'api" },
    { "method": "POST",   "path": "/api/v1/auth/register",                        "handler": "auth.register",            "family": "auth",    "auth": false, "note": "online_id + password (+ email, + registration_key se la registrazione è chiusa)" },
    { "method": "POST",   "path": "/api/v1/auth/login",                           "handler": "auth.login",               "family": "auth",    "auth": false, "note": "rilascia un token di sessione" },
    { "method": "POST",   "path": "/api/v1/auth/logout",                          "handler": "auth.logout",              "family": "auth",    "auth": true },
    { "method": "POST",   "path": "/api/v1/auth/password",                        "handler": "auth.changePassword",      "family": "auth",    "auth": true, "note": "chiude le altre sessioni" },
    { "method": "GET",    "path": "/api/v1/me",                                   "handler": "account.me",               "family": "account", "auth": true },
    { "method": "GET",    "path": "/api/v1/endpoints",                            "handler": "info.endpoints",           "family": "info",    "auth": false, "note": "elenco delle rotte" },
    { "method": "GET",    "path": "/api/v1/profile",                              "handler": "social.profile",           "family": "social",  "auth": true, "note": "profilo Omega: account + presenza + conteggi amici" },
    { "method": "GET",    "path": "/api/v1/friends",                              "handler": "social.friends",           "family": "social",  "auth": true, "note": "amici accettati (con presenza) + richieste in/out" },
    { "method": "POST",   "path": "/api/v1/friends/request",                      "handler": "social.friendRequest",     "family": "social",  "auth": true, "note": "{online_id}: invia richiesta (auto-accetta se inversa già pending)" },
    { "method": "POST",   "path": "/api/v1/friends/accept",                       "handler": "social.friendAccept",      "family": "social",  "auth": true, "note": "{online_id}: accetta una richiesta in entrata" },
    { "method": "POST",   "path": "/api/v1/friends/decline",                      "handler": "social.friendDecline",     "family": "social",  "auth": true, "note": "{online_id}: rifiuta una richiesta in entrata" },
    { "method": "DELETE", "path": "/api/v1/friends/:onlineId",                    "handler": "social.friendRemove",      "family": "social",  "auth": true, "note": "rimuove amicizia o richiesta in entrambe le direzioni" },
    { "method": "GET",    "path": "/api/v1/presence",                             "handler": "social.presence",          "family": "social",  "auth": true, "note": "la mia presenza + quella degli amici" },
    { "method": "POST",   "path": "/api/v1/presence",                             "handler": "social.presenceSet",       "family": "social",  "auth": true, "note": "{status,game_id?,game_name?}: aggiorna presenza + heartbeat" },
    { "method": "GET",    "path": "/api/v1/activity",                             "handler": "social.activity",          "family": "social",  "auth": true, "note": "attività recenti di me + amici" },
    { "method": "GET",    "path": "/api/v1/sync",                                 "handler": "hub.sync",                 "family": "social",  "auth": true, "note": "stato home: contatori, notifiche nuove (since), amici+presenza, party, inviti; fa da heartbeat" },
    { "method": "GET",    "path": "/api/v1/notifications",                        "handler": "hub.notifications",        "family": "social",  "auth": true, "note": "ultime 50 notifiche" },
    { "method": "POST",   "path": "/api/v1/notifications/read",                   "handler": "hub.notificationsRead",    "family": "social",  "auth": true, "note": "{id?}: segna letta una / tutte" },
    { "method": "POST",   "path": "/api/v1/notifications/clear",                  "handler": "hub.notificationsClear",   "family": "social",  "auth": true, "note": "cancella tutte le notifiche" },
    { "method": "GET",    "path": "/api/v1/users/search",                         "handler": "hub.usersSearch",          "family": "social",  "auth": true, "note": "?q=: cerca account Omega (con relazione)" },
    { "method": "GET",    "path": "/api/v1/users/:onlineId",                      "handler": "hub.userProfile",          "family": "social",  "auth": true, "note": "profilo pubblico + relazione + attività (se amici)" },
    { "method": "POST",   "path": "/api/v1/profile",                              "handler": "hub.profileUpdate",        "family": "social",  "auth": true, "note": "{about_me?,avatar?}" },
    { "method": "GET",    "path": "/api/v1/messages",                             "handler": "hub.conversations",        "family": "social",  "auth": true, "note": "conversazioni dirette" },
    { "method": "GET",    "path": "/api/v1/messages/:onlineId",                   "handler": "hub.thread",               "family": "social",  "auth": true, "note": "?after=: thread con un amico (segna letto)" },
    { "method": "POST",   "path": "/api/v1/messages/:onlineId",                   "handler": "hub.sendMessage",          "family": "social",  "auth": true, "note": "{text}: messaggio a un amico" },
    { "method": "GET",    "path": "/api/v1/party",                                "handler": "hub.party",                "family": "social",  "auth": true, "note": "party attuale + inviti" },
    { "method": "POST",   "path": "/api/v1/party",                                "handler": "hub.partyCreate",          "family": "social",  "auth": true, "note": "{name?}: crea party" },
    { "method": "POST",   "path": "/api/v1/party/invite",                         "handler": "hub.partyInvite",          "family": "social",  "auth": true, "note": "{online_id}" },
    { "method": "POST",   "path": "/api/v1/party/join",                           "handler": "hub.partyJoin",            "family": "social",  "auth": true, "note": "{party_id}: accetta invito" },
    { "method": "POST",   "path": "/api/v1/party/decline",                        "handler": "hub.partyDecline",         "family": "social",  "auth": true, "note": "{party_id}" },
    { "method": "POST",   "path": "/api/v1/party/leave",                          "handler": "hub.partyLeave",           "family": "social",  "auth": true },
    { "method": "POST",   "path": "/api/v1/party/mute",                           "handler": "hub.partyMute",            "family": "social",  "auth": true, "note": "{muted}" },
    { "method": "GET",    "path": "/api/v1/party/messages",                       "handler": "hub.partyMessagesGet",     "family": "social",  "auth": true, "note": "?after=" },
    { "method": "POST",   "path": "/api/v1/party/messages",                       "handler": "hub.partyMessagesPost",    "family": "social",  "auth": true, "note": "{text}" },
    { "method": "GET",    "path": "/api/v1/news",                                 "handler": "hub.news",                 "family": "social",  "auth": true, "note": "?game_id=" },
    { "method": "GET",    "path": "/api/v1/news/:newsId/image",                   "handler": "hub.newsImage",            "family": "social",  "auth": true, "note": "immagine dell'articolo (proxy + cache)" },
    { "method": "GET",    "path": "/api/v1/games/:gameId",                        "handler": "hub.game",                 "family": "social",  "auth": true, "note": "amici che giocano ora, chi ci ha giocato, news" },
    { "method": "GET",    "path": "/api/v1/browse",                               "handler": "browse.browse",            "family": "social",  "auth": true, "note": "?url= o ?q=: pagina web ridotta a blocchi (browser Omega)" },
    { "method": "GET",    "path": "/api/v1/browse/img/:id",                       "handler": "browse.browseImage",       "family": "social",  "auth": true, "note": "immagine di una pagina (proxy)" },
    { "method": "POST",   "path": "/api/v1/media/upload",                         "handler": "media.upload",             "family": "social",  "auth": true, "note": "?kind=avatar|cover&ext=: carica foto/video (corpo = file)" },
    { "method": "POST",   "path": "/api/v1/media/clear",                          "handler": "media.clear",              "family": "social",  "auth": true, "note": "?kind=: torna all'avatar/copertina predefiniti" },
    { "method": "GET",    "path": "/api/v1/media/:id/:frame",                     "handler": "media.frame",              "family": "social",  "auth": true, "note": "fotogramma JPEG di un avatar/copertina" },
    { "method": "GET",    "path": "/api/v1/store/apps",                           "handler": "store.listApps",           "family": "store",   "auth": true, "note": "?sort=recent|top|downloads&q=&tag=&mine=1: homebrew pubblicati" },
    { "method": "POST",   "path": "/api/v1/store/apps",                           "handler": "store.publishApp",         "family": "store",   "auth": true, "note": "pubblica un homebrew {title,tagline,description,category,version,title_id?,icon_url,cover_url,screenshots[],hashtags[],download_url,file_kind}" },
    { "method": "GET",    "path": "/api/v1/store/apps/:id",                       "handler": "store.getApp",             "family": "store",   "auth": true, "note": "scheda completa + commenti + mio voto/valutazione" },
    { "method": "POST",   "path": "/api/v1/store/apps/:id",                       "handler": "store.updateApp",          "family": "store",   "auth": true, "note": "modifica (solo autore)" },
    { "method": "DELETE", "path": "/api/v1/store/apps/:id",                       "handler": "store.deleteApp",          "family": "store",   "auth": true, "note": "rimuove (solo autore)" },
    { "method": "GET",    "path": "/api/v1/store/apps/:id/cover",                 "handler": "store.appCover",           "family": "store",   "auth": true, "note": "immagine di copertina (proxy+cache)" },
    { "method": "GET",    "path": "/api/v1/store/apps/:id/icon",                  "handler": "store.appIcon",            "family": "store",   "auth": true, "note": "icona (proxy+cache)" },
    { "method": "GET",    "path": "/api/v1/store/apps/:id/shot/:n",               "handler": "store.appShot",            "family": "store",   "auth": true, "note": "screenshot n (proxy+cache)" },
    { "method": "GET",    "path": "/api/v1/store/apps/:id/download",              "handler": "store.appDownload",        "family": "store",   "auth": true, "note": "risolve il link: {url,kind,size,title_id}" },
    { "method": "POST",   "path": "/api/v1/store/apps/:id/vote",                  "handler": "store.vote",               "family": "store",   "auth": true, "note": "{value:1|-1|0} mi piace / non mi piace" },
    { "method": "POST",   "path": "/api/v1/store/apps/:id/rate",                  "handler": "store.rate",               "family": "store",   "auth": true, "note": "{stars:1..5}" },
    { "method": "GET",    "path": "/api/v1/store/apps/:id/comments",              "handler": "store.comments",           "family": "store",   "auth": true },
    { "method": "POST",   "path": "/api/v1/store/apps/:id/comments",              "handler": "store.addComment",         "family": "store",   "auth": true, "note": "{text}" },
    { "method": "DELETE", "path": "/api/v1/store/apps/:id/comments/:commentId",   "handler": "store.deleteComment",      "family": "store",   "auth": true },
    { "method": "GET",    "path": "/api/v1/library/source",                       "handler": "store.getSource",          "family": "store",   "auth": true, "note": "la mia sorgente JSON" },
    { "method": "POST",   "path": "/api/v1/library/source",                       "handler": "store.setSource",          "family": "store",   "auth": true, "note": "{url,name?}" },
    { "method": "POST",   "path": "/api/v1/library/sync",                         "handler": "store.syncLibrary",        "family": "store",   "auth": true, "note": "rilegge il JSON e riempie la libreria" },
    { "method": "GET",    "path": "/api/v1/library/items",                        "handler": "store.listItems",          "family": "store",   "auth": true, "note": "?q=&platform=PS4|PS5" },
    { "method": "GET",    "path": "/api/v1/library/items/:id",                    "handler": "store.getItem",            "family": "store",   "auth": true },
    { "method": "GET",    "path": "/api/v1/library/items/:id/cover",              "handler": "store.itemCover",          "family": "store",   "auth": true },
    { "method": "GET",    "path": "/api/v1/library/items/:id/shot/:n",            "handler": "store.itemShot",           "family": "store",   "auth": true },
    { "method": "GET",    "path": "/api/v1/library/items/:id/download",           "handler": "store.itemDownload",       "family": "store",   "auth": true },
    { "method": "POST",   "path": "/api/v1/store/apps/:id/report",                "handler": "store.report",             "family": "store",   "auth": true, "note": "{reason, note?, comment_id?}: segnala un homebrew o un commento" },
    { "method": "POST",   "path": "/api/v1/posts",                                "handler": "wall.create",              "family": "social",  "auth": true, "note": "{text 1..500, game_id?, game_name?}: nuovo post in bacheca (20/ora)" },
    { "method": "GET",    "path": "/api/v1/feed",                                 "handler": "wall.feed",                "family": "social",  "auth": true, "note": "?before=<post_id>&limit=20: post miei e degli amici" },
    { "method": "GET",    "path": "/api/v1/users/:onlineId/posts",                "handler": "wall.userPosts",           "family": "social",  "auth": true, "note": "?before=&limit=: post di un utente (io o amici; altrimenti 403 not_friends)" },
    { "method": "GET",    "path": "/api/v1/posts/:id",                            "handler": "wall.get",                 "family": "social",  "auth": true, "note": "un post" },
    { "method": "DELETE", "path": "/api/v1/posts/:id",                            "handler": "wall.remove",              "family": "social",  "auth": true, "note": "elimina (solo autore)" },
    { "method": "POST",   "path": "/api/v1/posts/:id/like",                       "handler": "wall.like",                "family": "social",  "auth": true, "note": "{like:true|false}" },
    { "method": "GET",    "path": "/api/v1/posts/:id/comments",                   "handler": "wall.comments",            "family": "social",  "auth": true, "note": "commenti, dal più vecchio" },
    { "method": "POST",   "path": "/api/v1/posts/:id/comments",                   "handler": "wall.addComment",          "family": "social",  "auth": true, "note": "{text 1..300}" },
    { "method": "DELETE", "path": "/api/v1/posts/:id/comments/:commentId",        "handler": "wall.deleteComment",       "family": "social",  "auth": true, "note": "autore del commento o del post" },
    { "method": "POST",   "path": "/api/v1/posts/:id/report",                     "handler": "wall.report",              "family": "social",  "auth": true, "note": "{reason: spam|contenuto_offensivo|molestie|altro, note?}" },
    { "method": "POST",   "path": "/api/v1/posts/:id/comments/:commentId/report", "handler": "wall.reportComment",       "family": "social",  "auth": true, "note": "{reason, note?}" },
    { "method": "POST",   "path": "/api/v1/status",                               "handler": "people.setStatus",         "family": "social",  "auth": true, "note": "{mode: online|away|dnd|invisible, message? ≤60}" },
    { "method": "POST",   "path": "/api/v1/users/:onlineId/block",                "handler": "people.block",             "family": "social",  "auth": true, "note": "blocca (chiude amicizia e richieste)" },
    { "method": "DELETE", "path": "/api/v1/users/:onlineId/block",                "handler": "people.unblock",           "family": "social",  "auth": true, "note": "sblocca" },
    { "method": "GET",    "path": "/api/v1/blocks",                               "handler": "people.blocks",            "family": "social",  "auth": true, "note": "utenti che ho bloccato" },
    { "method": "GET",    "path": "/api/v1/privacy",                              "handler": "people.getPrivacy",        "family": "social",  "auth": true },
    { "method": "POST",   "path": "/api/v1/privacy",                              "handler": "people.setPrivacy",        "family": "social",  "auth": true, "note": "{messages: everyone|friends, friend_requests: everyone|friends_of_friends|nobody, show_activity: bool}" },
    { "method": "POST",   "path": "/api/v1/users/:onlineId/report",               "handler": "people.reportUser",        "family": "social",  "auth": true, "note": "{reason: spam|molestie|contenuto_offensivo|impersonificazione|altro, note?}" },
    { "method": "GET",    "path": "/api/v1/friends/suggestions",                  "handler": "people.suggestions",       "family": "social",  "auth": true, "note": "amici di amici e stessi giochi (≤15)" },
    { "method": "POST",   "path": "/api/v1/invites",                              "handler": "people.invite",            "family": "social",  "auth": true, "note": "{to:[online_id] ≤16, game_id, game_name, text? ≤120}: invito a giocare (20/ora)" },
    { "method": "POST",   "path": "/api/v1/groups",                               "handler": "groups.create",            "family": "social",  "auth": true, "note": "{name 1..40, members:[online_id]}" },
    { "method": "GET",    "path": "/api/v1/groups",                               "handler": "groups.list",              "family": "social",  "auth": true, "note": "i miei gruppi, attività più recente prima" },
    { "method": "GET",    "path": "/api/v1/groups/:id",                           "handler": "groups.get",               "family": "social",  "auth": true, "note": "scheda di un gruppo" },
    { "method": "POST",   "path": "/api/v1/groups/:id",                           "handler": "groups.rename",            "family": "social",  "auth": true, "note": "{name}: rinomina (solo proprietario)" },
    { "method": "GET",    "path": "/api/v1/groups/:id/messages",                  "handler": "groups.messages",          "family": "social",  "auth": true, "note": "?after=<message_id>&limit=50 (segna come letti)" },
    { "method": "POST",   "path": "/api/v1/groups/:id/messages",                  "handler": "groups.send",              "family": "social",  "auth": true, "note": "{text 1..500} (30/min)" },
    { "method": "POST",   "path": "/api/v1/groups/:id/members",                   "handler": "groups.addMembers",        "family": "social",  "auth": true, "note": "{add:[online_id]} (max 32 membri)" },
    { "method": "DELETE", "path": "/api/v1/groups/:id/members/:onlineId",         "handler": "groups.removeMember",      "family": "social",  "auth": true, "note": "toglie un membro (solo proprietario)" },
    { "method": "POST",   "path": "/api/v1/groups/:id/leave",                     "handler": "groups.leave",             "family": "social",  "auth": true },
    { "method": "GET",    "path": "/api/v1/stats/me",                             "handler": "stats.me",                 "family": "social",  "auth": true, "note": "il mio tempo di gioco (totale, settimana, per gioco)" },
    { "method": "GET",    "path": "/api/v1/stats/friends",                        "handler": "stats.friends",            "family": "social",  "auth": true, "note": "?game_id=&period=week|all: classifica tra amici" },
    { "method": "POST",   "path": "/api/v1/party/voice",                          "handler": "voice.post",               "family": "social",  "auth": true, "note": "?codec=opus|adpcm&seq=: un pezzo audio (octet-stream, ≤8 KB)" },
    { "method": "GET",    "path": "/api/v1/party/voice",                          "handler": "voice.poll",               "family": "social",  "auth": true, "note": "?after=<cursor>&wait=1: audio degli altri (binario OVC1, long-poll 1,5 s)" },
    { "method": "GET",    "path": "/api/v1/legal",                                "handler": "legal.json",               "family": "legal",   "auth": false, "note": "privacy, termini, licenze in JSON (per l'app)" },
    { "method": "GET",    "path": "/legal",                                       "handler": "legal.index",              "family": "legal",   "auth": false },
    { "method": "GET",    "path": "/legal/privacy",                               "handler": "legal.privacyPage",        "family": "legal",   "auth": false },
    { "method": "GET",    "path": "/legal/terms",                                 "handler": "legal.termsPage",          "family": "legal",   "auth": false },
    { "method": "GET",    "path": "/legal/licenses",                              "handler": "legal.licensesPage",       "family": "legal",   "auth": false },
    { "method": "GET",    "path": "/source",                                      "handler": "legal.sourcePage",         "family": "legal",   "auth": false, "note": "codice sorgente dell'app (GPL)" },
    { "method": "GET",    "path": "/source/omega-src.tar.gz",                     "handler": "legal.sourceTar",          "family": "legal",   "auth": false },
    { "method": "GET",    "path": "/api/v1/account/export",                       "handler": "account.exportData",       "family": "account", "auth": true, "note": "tutti i miei dati (GDPR art. 15/20)" },
    { "method": "POST",   "path": "/api/v1/account/delete",                       "handler": "account.deleteAccount",    "family": "account", "auth": true, "note": "{password}: elimina l'account e tutti i contenuti" },
    { "method": "POST",   "path": "/api/v1/account/terms",                        "handler": "account.acceptTerms",      "family": "account", "auth": true, "note": "{version}: accetta i termini aggiornati" },
    { "method": "GET",    "path": "/admin",                                       "handler": "admin.page",               "family": "admin",   "auth": false, "note": "pannello di amministrazione web" },
    { "method": "POST",   "path": "/admin/api/login",                             "handler": "admin.login",              "family": "admin",   "auth": false },
    { "method": "POST",   "path": "/admin/api/logout",                            "handler": "admin.logout",             "family": "admin",   "auth": "admin" },
    { "method": "GET",    "path": "/admin/api/me",                                "handler": "admin.me",                 "family": "admin",   "auth": "admin" },
    { "method": "GET",    "path": "/admin/api/stats",                             "handler": "admin.stats",              "family": "admin",   "auth": "admin" },
    { "method": "GET",    "path": "/admin/api/reports",                           "handler": "admin.reports",            "family": "admin",   "auth": "admin" },
    { "method": "POST",   "path": "/admin/api/reports/:id",                       "handler": "admin.reportAction",       "family": "admin",   "auth": "admin" },
    { "method": "GET",    "path": "/admin/api/apps",                              "handler": "admin.apps",               "family": "admin",   "auth": "admin" },
    { "method": "POST",   "path": "/admin/api/apps/:id",                          "handler": "admin.appAction",          "family": "admin",   "auth": "admin" },
    { "method": "DELETE", "path": "/admin/api/apps/:id",                          "handler": "admin.appDelete",          "family": "admin",   "auth": "admin" },
    { "method": "GET",    "path": "/admin/api/comments",                          "handler": "admin.comments",           "family": "admin",   "auth": "admin" },
    { "method": "POST",   "path": "/admin/api/comments/:id",                      "handler": "admin.commentAction",      "family": "admin",   "auth": "admin" },
    { "method": "DELETE", "path": "/admin/api/comments/:id",                      "handler": "admin.commentDelete",      "family": "admin",   "auth": "admin" },
    { "method": "GET",    "path": "/admin/api/social-reports",                    "handler": "admin.socialReports",      "family": "admin",   "auth": "admin" },
    { "method": "POST",   "path": "/admin/api/social-reports/:id",                "handler": "admin.socialReportAction", "family": "admin",   "auth": "admin" },
    { "method": "GET",    "path": "/admin/api/posts",                             "handler": "admin.posts",              "family": "admin",   "auth": "admin" },
    { "method": "POST",   "path": "/admin/api/posts/:id",                         "handler": "admin.postAction",         "family": "admin",   "auth": "admin" },
    { "method": "DELETE", "path": "/admin/api/posts/:id",                         "handler": "admin.postDelete",         "family": "admin",   "auth": "admin" },
