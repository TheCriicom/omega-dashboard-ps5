{
  "id": "/app/",
  "name": "Omega",
  "short_name": "Omega",
  "description": "Amici, messaggi, party, community e lo Store di homebrew della tua PS5, dal telefono e dal PC.",
  "lang": "it",
  "dir": "ltr",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0c0e14",
  "theme_color": "#0c0e14",
  "categories": ["social", "games", "entertainment"],
  "icons": [
    { "src": "/app/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/app/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/app/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Messaggi", "short_name": "Messaggi", "url": "/app/#/messages", "icons": [{ "src": "/app/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Store", "short_name": "Store", "url": "/app/#/store", "icons": [{ "src": "/app/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "La mia console", "short_name": "Console", "url": "/app/#/console", "icons": [{ "src": "/app/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
